.tests/*
!.tests/*.sh
!.tests/fixtures/
.snakemake
ext
logs
.DS_Store
.temp_dorado_model*
.vscode
results/
resources/tools/*
# Sibling source repos cloned in here to build against -- escapepod-rs is the
# GPU build the escpod pin is cut from, leech is left over from before #124
# retired it. Checkouts of other repositories, not content of this one.
resources/escapepod-rs/
resources/leech/
*.bam
*.pod5
# ...except the checked-in LDX demux fixture, which is deliberately
# versioned: it is the only barcoded input the demux path can be tested
# against, and it is 4.6 MB. See .tests/fixtures/ldx-demux/README.md.
!.tests/fixtures/**/*.pod5
# samtools indexes the fixture reference in place during a run; derived, not vendored
.tests/fixtures/**/*.fai
# `escpod demux --annotate` writes a .p5s sidecar NEXT TO the POD5 it describes --
# i.e. into the raw data directory, which for the committed fixture is inside this
# repo. Derived from a run, never vendored.
*.p5s
# pod5 writes these while migrating a run to a newer file version, and names
# them after the version pair -- so a v3->v4 pattern stops matching the moment
# pod5 ships v5. Match any pair.
.tmp_pod5_v?_v?_migration_*/

# python testing
__pycache__/
.coverage

# ML model outputs
model_best/
resources/models/.mod_models_ready

# Loose files dropped into the demux model dir by `escpod demux models fetch`.
# What is vendored here is a bundle DIRECTORY -- that is what
# `pixi run verify-demux-model` iterates and what the README documents -- so a
# bare .onnx/.json beside them is a fetch cache, not a tracked artifact.
resources/models/demux/*.onnx
resources/models/demux/*.json

# Parsed-and-pickled form of the k-mer level table, written beside the .txt on
# first use. Derived; the .txt is the vendored file the charging bundle pins.
resources/kmers/*.pkl

# Worktrees created by Claude Code live inside the repo.
.claude/worktrees/

# generated at render time by Snakemake rule
workflow/report/_custom.qmd
