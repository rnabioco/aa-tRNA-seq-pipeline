# Main entrypoint of the workflow.

from snakemake.utils import min_version

min_version("8.0")


configfile: "config/config-base.yml"


# Dorado path setup (modkit is managed by pixi)
DORADO_VERSION = config["dorado_version"]
DORADO_DIR = f"resources/tools/dorado/{DORADO_VERSION}"
ESCPOD_VERSION = config.get("escpod_version", "0.11.0")
ESCPOD_DIR = f"resources/tools/escpod/{ESCPOD_VERSION}"


onstart:
    import os
    import shutil
    import subprocess

    # Put the pinned tool bins on PATH for every job. setup-env.sh does this
    # too, but a cluster job need not have run the pixi activation hook, so the
    # prefix is what actually guarantees it.
    dorado_bin_path = os.path.abspath(f"{DORADO_DIR}/bin")
    escpod_bin_path = os.path.abspath(f"{ESCPOD_DIR}/bin")
    tool_bins = f"{dorado_bin_path}:{escpod_bin_path}"
    os.environ["PATH"] = f"{tool_bins}:{os.environ['PATH']}"
    # NOTE: the `set -euo pipefail` is load-bearing. shell.prefix() REPLACES
    # snakemake's default prefix, and that default IS bash strict mode
    # (snakemake/shell.py `_get_process_prefix`). Without it restored here,
    # every pipeline in every rule reports only its LAST command's exit
    # status, so a failing `bwa mem | samtools view | samtools sort` looks
    # like a success with an empty BAM.
    shell.prefix(f"set -euo pipefail; export PATH={tool_bins}:$PATH; ")
    # Verify dorado version matches config
    dorado_bin = os.path.join(dorado_bin_path, "dorado")
    if os.path.isfile(dorado_bin):
        try:
            result = subprocess.run(
                [dorado_bin, "--version"],
                capture_output=True,
                text=True,
                timeout=10,
            )
            installed = result.stderr.strip()
            if installed and installed != DORADO_VERSION:
                logger.warning(
                    f"Installed dorado ({installed}) does not match "
                    f"config dorado_version ({DORADO_VERSION}). "
                    f"Run 'pixi run setup' to install the correct version."
                )
        except Exception:
            pass
    conda_prefix = os.environ.get("CONDA_PREFIX", "")  # tool path validation
    repo_root = os.path.dirname(os.path.dirname(workflow.snakefile))
    tools_to_check = [
        ("dorado", [os.path.join(repo_root, "resources")]),
        ("samtools", [conda_prefix]),
        ("bwa", [conda_prefix]),
        ("modkit", [conda_prefix]),
        # escpod is unconditional: merge_pods and classify_charging use it on
        # every run, not just demux runs.
        ("escpod", [os.path.join(repo_root, "resources")]),
    ]
    if config.get("warpdemux", {}).get("enabled", False):
        tools_to_check.append(("warpdemux", [conda_prefix]))
        # nothing shells out to the pod5 CLI any more, but WarpDemuX imports
        # the pod5 python package and installing it is what puts the CLI on
        # PATH -- so this still stands in for "warpdemux can read POD5s".
        tools_to_check.append(("pod5", [conda_prefix]))
    if config.get("classify_aa", {}).get("enabled", False):
        tools_to_check.append(
            ("leech", [conda_prefix, os.path.join(repo_root, "resources")])
        )
    for tool_name, allowed_prefixes in tools_to_check:
        tool_path = shutil.which(tool_name)
        if tool_path is None:
            logger.warning(
                f"Tool '{tool_name}' not found in PATH. "
                f"Run 'pixi run setup' to install."
            )
            continue
        tool_path = os.path.realpath(tool_path)
        if not any(
            tool_path.startswith(os.path.realpath(p)) for p in allowed_prefixes if p
        ):
            logger.warning(
                f"Tool '{tool_name}' resolves to {tool_path}, which is outside "
                f"the expected environment ({', '.join(allowed_prefixes)}). "
                f"This may cause version mismatches. "
                f"Ensure you are running within 'pixi shell'."
            )
        else:
            logger.info(f"Tool '{tool_name}' OK: {tool_path}")


import datetime
import sys

PIPELINE_START_TIME = datetime.datetime.now(datetime.timezone.utc).isoformat()

SNAKEFILE_DIR = os.path.dirname(workflow.snakefile)
PIPELINE_DIR = os.path.dirname(SNAKEFILE_DIR)


include: "rules/common.smk"
include: "rules/aatrnaseq-reference.smk"
include: "rules/aatrnaseq-process.smk"
include: "rules/aatrnaseq-charging.smk"
include: "rules/aatrnaseq-qc.smk"
include: "rules/aatrnaseq-modifications.smk"
include: "rules/aatrnaseq-odds-ratios.smk"
include: "rules/aatrnaseq-report.smk"
include: "rules/clean.smk"


localrules:
    download_mod_models,
    generate_squiggy_session,
    clean,


# Conditionally include demultiplexing rules (WarpDemuX, or escapepod CRF)
if is_demux_enabled():

    include: "rules/demux.smk"


# Conditionally include amino acid classification rules
if config.get("classify_aa", {}).get("enabled", False):

    include: "rules/aatrnaseq-classify-aa.smk"


# Add scripts directory to path for manifest generation
sys.path.insert(0, os.path.join(SNAKEFILE_DIR, "scripts"))


onsuccess:
    from generate_manifest import generate_manifest

    generate_manifest(
        config=config,
        samples=samples,
        status="success",
        start_time=PIPELINE_START_TIME,
        output_dir=config["output_directory"],
        pipeline_dir=PIPELINE_DIR,
    )


onerror:
    from generate_manifest import generate_manifest

    generate_manifest(
        config=config,
        samples=samples,
        status="failed",
        start_time=PIPELINE_START_TIME,
        output_dir=config["output_directory"],
        pipeline_dir=PIPELINE_DIR,
    )


report_metadata()


rule all:
    input:
        pipeline_outputs(),
